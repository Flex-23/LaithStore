// Prisma schema for the storefront.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  AGENT
  /// موظف المتابعة: يتابع كل الطلبات ويغيّر حالتها بلا مبالغ.
  FOLLOWUP
  /// موظف الحسابات: كل الصفحات المالية وكشوفات المندوبين.
  ACCOUNTANT
}

enum OrderStatus {
  PENDING
  SHIPPED
  DELIVERED
  /// مرفوض
  CANCELLED
  /// تم استلام الطلب المرفوض — المواد رجعت للمخزون.
  RETURNED
}

model User {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  governorate String
  password    String
  role        Role     @default(USER)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Agent (المندوب) fields; only meaningful when role = AGENT ------------
  /** Sequential number assigned on creation; shown as AG-0001. */
  agentNumber       Int?    @unique
  /** Fixed amount (IQD) the agent earns per order they dispatch (shipped/delivered). */
  commissionPerOrder Float  @default(0)
  canManageProducts Boolean @default(false)
  canManageOrders   Boolean @default(false)
  canViewDashboard  Boolean @default(false)
  canManageHome     Boolean @default(false)
  /** Deactivated agents can't sign in. */
  isActive          Boolean @default(true)

  assignedOrders Order[]   @relation("AgentOrders")
  expenses       Expense[] @relation("ExpenseRecipient")

  @@index([role])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String    @db.Text
  image       String    @db.Text
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id              String      @id @default(cuid())
  name            String
  description     String      @db.Text
  /// سعر الشراء (التكلفة) — أساس حساب الربح.
  costPrice       Float       @default(0)
  /// سعر البيع.
  price           Float
  discountedPrice Float?
  isDiscounted    Boolean     @default(false)
  image           String      @db.Text
  stockQuantity   Int         @default(0)
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([categoryId])
}

model Order {
  id          String      @id @default(cuid())
  /// Registered customer; null for orders an agent registered by hand.
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Customer details typed by the agent (null on storefront orders — use `user`).
  customerName        String?
  customerPhone       String?
  customerGovernorate String?
  customerAddress     String? @db.Text
  /// Delivery company chosen by the agent.
  deliveryCompany     String?
  /// أجور النقل — typed by hand; included in totalAmount, excluded from profit.
  deliveryFee         Float   @default(0)
  status     OrderStatus @default(PENDING)
  totalAmount Float
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  /** Agent handling this order (set automatically on first status change, or by the admin). */
  agentId                String?
  agent                  User?   @relation("AgentOrders", fields: [agentId], references: [id], onDelete: SetNull)
  /** Agent fee (IQD) snapshotted at assignment time, so later rate changes don't rewrite history. */
  agentCommission        Float?

  @@index([userId])
  @@index([status])
  @@index([agentId])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  priceAtPurchase Float
  /// Purchase cost per unit at order time, so later cost edits do not rewrite profit.
  costAtPurchase  Float   @default(0)

  @@index([orderId])
  @@index([productId])
}

/// Money paid out by the admin (to an agent or anyone else).
model Expense {
  id            String   @id @default(cuid())
  amount        Float
  /** Who received the money (agent name copied here, or free text). */
  recipientName String
  agentId       String?
  agent         User?    @relation("ExpenseRecipient", fields: [agentId], references: [id], onDelete: SetNull)
  note          String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([agentId])
  @@index([createdAt])
}

/// Editable copy/images for the storefront home page (single row, id = "main").
model HomeContent {
  id            String   @id @default("main")
  heroEyebrow   String
  /** Use a line break to split the headline; `heroHighlight` is colored if found. */
  heroTitle     String   @db.Text
  heroHighlight String
  heroSubtitle  String   @db.Text
  heroCta       String
  heroImage1    String   @db.Text
  heroImage2    String   @db.Text
  promoEyebrow  String
  promoTitle    String
  promoText     String   @db.Text
  promoCta      String
  promoImage    String   @db.Text
  updatedAt     DateTime @updatedAt
}
